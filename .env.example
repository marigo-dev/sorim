# Minecraft
MC_HOST=localhost
MC_PORT=25565
MC_VERSION=26.2
MC_USERNAME=marigo
AUTONOMOUS_ON_START=false
LOOP_DELAY_MS=1500
TASK_TOOL_TIMEOUT_MS=120000
AUTONOMOUS_TOOL_TIMEOUT_MS=600000
STOP_AT_LEVEL=
COLONY_LEASE_TTL_MS=120000
LOG_LEVEL=info

# AI planner
USE_LLM=true
USE_LLM_PLANNER=false
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_CONTEXT_SIZE=4096
LLM_TIMEOUT_MS=30000
CHAT_TIMEOUT_MS=45000

# OpenAI-compatible provider
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional explicit switch; MC_VERSION=26.2 enables the shim automatically
ENABLE_EXPERIMENTAL_26_2=false

# Colony mode
COLONY_ALPHA=Bot_Mico
COLONY_BETA=Bot_Mira
COLONY_ALPHA_ROLE=lumberjack
COLONY_BETA_ROLE=miner
# Leave empty to derive the settlement center from the bots' real spawn positions.
COLONY_CENTER=
COLONY_RUNTIME_MS=180000
COLONY_LOOP_DELAY_MS=1200
COLONY_BRAIN_INTERVAL_MS=30000
COLONY_TOOL_TIMEOUT_MS=90000
COLONY_SEED_RESOURCES=false
