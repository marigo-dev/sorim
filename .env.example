# Minecraft
MC_HOST=localhost
MC_PORT=25565
MC_VERSION=1.21
MC_USERNAME=marigo
AUTONOMOUS_ON_START=false
LOOP_DELAY_MS=1500
LOG_LEVEL=info

# AI planner
USE_LLM=true
USE_LLM_PLANNER=false
LLM_PROVIDER=ollama
LLM_TIMEOUT_MS=12000
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen3:4b

# OpenAI-compatible provider
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Native Minecraft 26.2 support is experimental
ENABLE_EXPERIMENTAL_26_2=false

# Colony mode
COLONY_ALPHA=marigo_alpha
COLONY_BETA=marigo_beta
COLONY_CENTER=1800,70,0
COLONY_RUNTIME_MS=180000
COLONY_LOOP_DELAY_MS=1200
