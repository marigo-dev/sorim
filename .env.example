# Minecraft connection
MC_HOST=localhost
MC_PORT=25565
MC_VERSION=1.21
MC_USERNAME=marigo
LOOP_DELAY_MS=1500

# Logging: silent, error, warn, info, debug
LOG_LEVEL=info

# LLM mode
# Options:
# - USE_LLM=false for deterministic skill-tree only
# - LLM_PROVIDER=ollama for local Ollama
# - LLM_PROVIDER=openai-compatible for OpenAI or compatible APIs
USE_LLM=true
LLM_PROVIDER=ollama
LLM_TIMEOUT_MS=12000

# Ollama
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen3:4b

# OpenAI-compatible API
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
